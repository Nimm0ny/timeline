        "search-results"
      ],
      "operationIds": [
        "notes_search"
      ],
      "sourcePaths": [
        "ui/src/pages/NotesPage.vue",
        "ui/src/components/notes/CommandPalette.vue",
        "ui/src/components/notes/NoteFeed.vue",
