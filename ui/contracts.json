          "id": "compact-desktop",
          "minWidth": 768,
          "maxWidth": 1023
        },
        {
          "id": "desktop",
          "minWidth": 1024,
          "maxWidth": 3840
        }
      ],
      "scenarios": [
        {
          "id": "notes.search-visible-result",
          "title": "从搜索命令面板找到并回读笔记",
          "summary": "通过键盘打开命令面板，输入查询词，观察可见结果和正式搜索请求，再通过 API 回读目标笔记。",
          "inputSchema": "UiSearchScenarioInput",
          "targetState": "search-results",
          "preconditions": [
            "query uniquely matches expectedNoteId"
          ],
          "cleanup": "none",
          "actions": [
            {
              "action": "press",
              "key": "Control+k"
            },
            {
              "action": "expect-visible",
              "role": "dialog",
              "name": "搜索命令面板"
            },
            {
              "action": "expect-focused",
              "role": "searchbox",
              "name": "搜索事件、笔记本或命令"
            },
            {
              "action": "fill",
              "role": "searchbox",
              "name": "搜索事件、笔记本或命令",
              "valueFrom": "query"
            },
            {
              "action": "expect-visible",
              "role": "option",
              "textFrom": "expectedHeadline"
            }
          ],
          "assertions": [
            {
              "kind": "operation-observed",
              "operationId": "notes_search"
            },
            {
              "kind": "no-horizontal-overflow"
            }
          ],
          "readback": {
            "operationId": "notes_search",
            "queryFrom": "query",
            "containsIdFrom": "expectedNoteId",
            "limit": 8
          }
        }
      ],
      "manualReview": [
        "结果层级、文案和视觉品质仍需人工判断"
      ],
      "mediaPolicy": "none"
    },
